# ==========================================================================
# Septentrional — .htaccess du frontend (SPA React/Vite + proxy SEO PHP)
# ==========================================================================

# Encodage par défaut
AddDefaultCharset UTF-8

# Pas de listing de répertoire, pas de négociation de contenu implicite
Options -Indexes -MultiViews

# ETag désactivé : le cache est déjà piloté explicitement par Cache-Control
# ci-dessous ; laisser ETag actif ne fait que créer des revalidations
# incohérentes si le site tourne un jour sur plusieurs serveurs.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# Ne jamais exposer les fichiers cachés (.env, .git*, etc.) même s'ils
# finissent par erreur dans ce dossier.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Expiration / cache navigateur
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------
# Headers de cache + de sécurité
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  # Assets hashés par Vite (nom de fichier change à chaque build) : cache long
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  # index.html/index.php : jamais en cache, sinon un déploiement n'est pas vu
  <FilesMatch "^index\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Sécurité — cohérent avec App\Http\Middleware\SecureHeaders côté API.
  # La CSP complète du site reste dans la balise <meta> d'index.html
  # (seule façon de la personnaliser par build sans toucher au serveur) ;
  # frame-ancestors, lui, est ignoré par une CSP en <meta> et ne peut être
  # posé que via un header HTTP — d'où sa présence ici uniquement.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Ne pas révéler la stack technique
  Header unset X-Powered-By
  Header always unset Server
</IfModule>
ServerSignature Off

<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>

# ---------------------------------------------------------------------
# Réécriture d'URL
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Domaines canoniques. L'environnement de test front.septentrional.tg
  #    doit rester sur son propre hôte et ne jamais basculer vers la production.
  RewriteCond %{HTTP_HOST} ^www\.septentrional\.tg$ [NC]
  RewriteRule ^ https://septentrional.tg%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.front\.septentrional\.tg$ [NC]
  RewriteRule ^ https://front.septentrional.tg%{REQUEST_URI} [L,R=301]

  # HTTPS obligatoire en conservant uniquement un hôte explicitement autorisé.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(?:front\.)?septentrional\.tg$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Ignorer les requêtes destinées à l'API backend Laravel (/api/v2/*,
  #    et toute version future : le préfixe /api/ suffit à les exclure)
  RewriteCond %{REQUEST_URI} !^/api/

  # Ne pas réécrire si le fichier ou le dossier existe déjà (assets CSS/JS, images, etc.)
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Toutes les requêtes passent par index.php (qui gère le SEO + sert React)
  RewriteRule . /index.php [L]
</IfModule>
